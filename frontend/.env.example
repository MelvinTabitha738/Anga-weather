# Base URL of the Anga Django backend.
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production (Vercel): set this to the deployed Render URL, e.g.
# VITE_API_BASE_URL=https://anga-api.onrender.com
#
# NOTE: everything in a Vite VITE_* variable is embedded in the JavaScript
# bundle and is therefore PUBLIC. The Weather-AI API key must never appear
# here - it lives only in the backend environment.
