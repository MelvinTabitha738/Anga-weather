# ---------------------------------------------------------------------------
# Anga - backend environment
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Django core ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret
DEBUG=True
# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Weather-AI upstream ---
# Get a key from https://weather-ai.co -> Dashboard -> API Keys.
# Keys are prefixed wai_ and are shown only once on creation.
WEATHER_AI_API_KEY=wai_your_key_here
WEATHER_AI_BASE_URL=https://api.weather-ai.co

# --- Database (PostgreSQL) ---
# Required when DEBUG=False. Omit in development to fall back to SQLite.
DATABASE_URL=postgres://anga:anga@localhost:5432/anga

# --- Cache (Redis) ---
# Omit in development to fall back to LocMemCache. Note that without Redis,
# request coalescing is per-process only and the cache dies with the process.
REDIS_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=anga

# --- Caching policy ---
# Fresh window: how long a cached response is served as current. 1800s = 30 min.
# Chosen against Weather-AI's MONTHLY quota (free tier: 1,000 req/month, roughly
# 33 upstream calls per day across every location). See README.
WEATHER_CACHE_TTL=1800
# Stale retention: how long an expired response is kept as a fallback.
# 21600s = 6h, deliberately long because a 429 here is a monthly quota lockout
# that clears at X-RateLimit-Reset, not in seconds.
WEATHER_STALE_TTL=21600

# --- Upstream behaviour ---
WEATHER_CONNECT_TIMEOUT=5
WEATHER_READ_TIMEOUT=10
# Single-flight: lock lifetime, and how long a follower waits for the leader.
WEATHER_LOCK_TTL=15
WEATHER_COALESCE_WAIT=12
# Stop calling upstream with fewer than this many monthly requests left.
WEATHER_QUOTA_RESERVE=25
# Backoff after a 5xx/timeout, and after a 429 with no usable reset header.
WEATHER_FAILURE_BACKOFF=60
WEATHER_DEFAULT_429_BACKOFF=900
WEATHER_MAX_BREAKER_SECONDS=86400
# Forecast days to request. The forecast arrives in the SAME response as
# current conditions, so 7 costs exactly the same one request as 1.
# Free plan allows 1-7, Pro 14, Scale 16.
WEATHER_FORECAST_DAYS=7

# Weather-AI defaults ai=true, which spends the smaller AI quota (200/mo free).
# Verified against the live API: ai_summary returns null on a free-plan key even
# with ai=true, so requesting it would spend that quota for nothing. Set True if
# your plan actually returns summaries.
WEATHER_INCLUDE_AI=False

# Language for the AI summary only ('en' or 'sw'). No effect on the numeric
# forecast, which carries no prose.
WEATHER_LANG=en

# How often to re-sync the authoritative quota reading from GET /v1/usage.
# The documented X-RateLimit-* headers do NOT exist on the live API, so this
# endpoint is the only way to observe quota - and it costs a request itself.
# 86400 = once a day, roughly 30 requests/month (3% of the free budget).
# Between syncs, upstream calls are counted locally and subtracted.
WEATHER_USAGE_TTL=86400

# How long one worker's claim on the usage sync is held. This is the shared
# lock that stops every worker/instance spending a request on /v1/usage at the
# same time, and it doubles as the retry backoff after a failed sync.
WEATHER_USAGE_LOCK_TTL=3600

# --- CORS ---
# Comma-separated exact origins of the frontend. No wildcards.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: allow that Vercel project's preview URLs (<slug>-<hash>.vercel.app).
VERCEL_PROJECT_SLUG=

# --- Our own API throttles (DRF) ---
THROTTLE_WEATHER=60/min
THROTTLE_LOCATIONS=120/min
THROTTLE_META=30/min

# --- Logging ---
LOG_LEVEL=INFO
